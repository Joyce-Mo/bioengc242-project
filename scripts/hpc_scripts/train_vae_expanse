#!/bin/bash
#SBATCH -A ucb368
#SBATCH --job-name=train_cc89_expanse
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=4
#SBATCH --cpus-per-task=10
#SBATCH --gpus=a100:4
#SBATCH --mem=92G
#SBATCH --time=00:05:00
#SBATCH -o logs/train_cc89_expanse_%j.out
#SBATCH -e logs/train_cc89_expanse_%j.err
#SBATCH -p gpu
#SBATCH --mail-user=jqmo@berkeley.edu
#SBATCH --mail-type=all

# Train baseline Protpardelle (cc89 config) on Expanse.
# cc89: all-atom EDM diffusion, DIT backbone, crop-conditional training,
# self-conditioning prob 0.9, lr=1e-4, warmup 1000 steps, batch_size=32.

set -euo pipefail

nvidia-smi || echo "nvidia-smi not available"

CONDA_ENV_PATH="${CONDA_ENV_PATH:-$HOME/.conda/envs/protpardelle}"
if [ ! -x "$CONDA_ENV_PATH/bin/python" ]; then
    echo "ERROR: $CONDA_ENV_PATH/bin/python not found" >&2
    exit 1
fi
export PATH="$CONDA_ENV_PATH/bin:$PATH"
export CONDA_PREFIX="$CONDA_ENV_PATH"
export CONDA_DEFAULT_ENV=protpardelle

echo "Using python: $(which python)"
python --version
python -c "import torch; print('torch', torch.__version__, 'cuda runtime', torch.version.cuda, 'is_available', torch.cuda.is_available())" || true

# Ensure protpardelle is importable
PROTPARDELLE_ROOT="$HOME/protpardelle-1c"
if ! python -c "import protpardelle" 2>/dev/null; then
    echo "Installing protpardelle from $PROTPARDELLE_ROOT"
    pip install -e "$PROTPARDELLE_ROOT" --quiet
fi

PROJECT_ROOT_DIR=$(python -c "from protpardelle.env import PROJECT_ROOT_DIR; print(PROJECT_ROOT_DIR)")

model_name="${model_name:-cc89_anvil}"

output_base="/expanse/lustre/scratch/jmo/temp_project"
output_dir="${output_base}/${model_name}_${SLURM_JOB_ID}_$(date +%Y%m%d)"
mkdir -p "$output_dir" logs

config_path="${PROJECT_ROOT_DIR}/examples/training/${model_name}.yaml"
project_name="protpardelle-1c"

if [ ! -f "$config_path" ]; then
    echo "ERROR: config not found: $config_path" >&2
    exit 1
fi

echo "model_name=$model_name"
echo "config_path=$config_path"
echo "output_dir=$output_dir"

python -m protpardelle.train \
    --config-path "${config_path}" \
    --output-dir "${output_dir}" \
    --project-name "${project_name}" \
    --exp-name "${model_name}"

echo "Done. Outputs in $output_dir"
ls -lh "$output_dir"
